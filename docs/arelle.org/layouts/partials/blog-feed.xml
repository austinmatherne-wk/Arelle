{{- /* The site has exactly one feed, served at three paths: /updates/index.xml
       (canonical, and the only one the site advertises), /index.xml, and
       /arelle/feed/index.xml (the WordPress feed URL). They carry the same
       items so that no subscriber sees a different site depending on which one
       they found. Context: the page being rendered. */ -}}
{{- $blog := site.GetPage "/updates" -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.Title }}</title>
    <link>{{ $blog.Permalink }}</link>
    <description>{{ $blog.Description }}</description>
    <language>{{ site.Language.Locale }}</language>
    <atom:link href="{{ .Permalink }}index.xml" rel="self" type="application/rss+xml" />
    {{- range $blog.RegularPagesRecursive.ByDate.Reverse }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <guid>{{ .Permalink }}</guid>
      <description>{{ .Content | transform.XMLEscape | safeHTML }}</description>
    </item>
    {{- end }}
  </channel>
</rss>
